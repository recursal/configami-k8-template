//
// Default input settings to use
//
{
	// Namespace to use
	//-------------------------------------------
	"namespace" : "hello-namespace",
	
	// Deployment name to use
	//-------------------------------------------
	"name" : "hello-world",

	// Rancher style deployment type
	//-------------------------------------------
	"deploymentType" : "deployment",

	// Rancher style deployment target name
	// defaults to "name"
	//-------------------------------------------
	//"deploymentName" : "hello-world",

	// Container port to use
	//-------------------------------------------
	"port" :         80,
	"portName":      "http-default",
	"portProtocol" : "TCP",
	// "targetPort": 8080,

	// nodePort settings
	//-------------------------------------------
	// "nodePort": 30100

	// Explicit service type (e.g. "LoadBalancer"). When set, the
	// clusterIP/nodePort block is skipped entirely.
	//-------------------------------------------
	// "serviceType": "LoadBalancer",

	// LB traffic policy ("Local" | "Cluster"); only rendered with serviceType
	//-------------------------------------------
	// "externalTrafficPolicy": "Cluster",

	// Extra metadata annotations (e.g. cloud LB settings), passed through
	//-------------------------------------------
	// "extraAnnotations": {
	// 	"service.beta.kubernetes.io/do-loadbalancer-name": "my-lb"
	// },

	// Full port list ([{ name, port, targetPort, protocol }]) — overrides
	// the single port/portName/portProtocol block above
	//-------------------------------------------
	// "portsArray": [
	// 	{ "name": "ssh", "port": 22, "targetPort": 2222, "protocol": "TCP" }
	// ],

	// clusterIP service mode
	//-------------------------------------------
	"clusterIP" : "auto"

	// Topology key settings
	//-------------------------------------------

	//
	// Configure to either
	//
	// - host
	// - zone
	// - region
	//
	"serviceTopologyKeyPreference": false

	// // Optional readiness probe
	// //-------------------------------------------
	// "readinessProbe": {
	// 	failureThreshold: 3
	// 	httpGet: {
	// 		path: /
	// 		port: 80
	// 		scheme: HTTP
	// 	}
	// 	initialDelaySeconds: 5
	// 	periodSeconds: 5
	// 	successThreshold: 2
	// 	timeoutSeconds: 5
	// }
}
